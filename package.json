{
  "name": "@aimbitgmbh/vikunja-mcp",
  "version": "1.0.0",
  "description": "MCP server for Vikunja task management, project management, and Vikunja 2.6+ API v2",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "vikunja-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/api-spec.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx --import dotenv/config src/index.ts",
    "build": "npm run clean && tsc && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "test:qwen": "tsx scripts/qwen-eval.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "check": "npm run typecheck && npm test",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai-assistant",
    "ai-integration",
    "vikunja",
    "vikunja-mcp",
    "mcp-server",
    "vikunja-api-v2",
    "tasks",
    "todo",
    "productivity",
    "task-management",
    "project-management",
    "kanban",
    "collaboration"
  ],
  "author": {
    "name": "aimbit GmbH",
    "email": "info@aimbit.de",
    "url": "https://aimbit.de"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimbitgmbh/vikunja-mcp"
  },
  "homepage": "https://github.com/aimbitgmbh/vikunja-mcp",
  "bugs": {
    "url": "https://github.com/aimbitgmbh/vikunja-mcp/issues",
    "email": "info@aimbit.de"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "undici": "^7.29.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@10.8.2"
}
