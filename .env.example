# Required: a Vikunja 2.6+ instance root or API URL.
VIKUNJA_URL=https://vikunja.example.com

# Required: create an API token in Vikunja under Settings > API Tokens.
VIKUNJA_API_TOKEN=your-api-token

# Optional connection settings.
VERIFY_SSL=true
VIKUNJA_REQUEST_TIMEOUT_MS=30000

# Permanent deletion is disabled by default.
ENABLE_TASK_DELETE=false
ENABLE_PROJECT_DELETE=false
ENABLE_LABEL_DELETE=false
ENABLE_NOTIFICATION_DELETE_ALL=false

# Optional Qwen/tool-selection evaluation settings used by npm run test:qwen.
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model
